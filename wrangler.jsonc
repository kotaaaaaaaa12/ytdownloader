{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-dlp-downloader",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "containers": [
    {
      "class_name": "DownloaderContainer",
      "image": "./container/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-4",
      "constraints": {
        "regions": [
          "APAC"
        ]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOADER",
        "class_name": "DownloaderContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DownloaderContainer"
      ]
    }
  ]
}
