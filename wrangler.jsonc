{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-dlp-downloader",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "INFO_RATE_LIMITER",
      "namespace_id": "2026092801",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "2026092802",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "containers": [
    {
      "class_name": "DownloaderContainer",
      "image": "./container/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOADER",
        "class_name": "DownloaderContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DownloaderContainer"
      ]
    }
  ]
}
